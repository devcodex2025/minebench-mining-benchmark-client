# Nightly channel: test infrastructure ONLY. scripts/check-channel-config.mjs
# fails the build if any endpoint resolves to production, and also fails if a
# variable is left unset - because the compiled fallbacks are production.
#
# A tester's machine is the expected target: point these at the test deployment
# that was started locally for the nightly build.
#
# Copy to `.env.nightly` (git-ignored) or let CI inject the same variables.
VITE_APP_CHANNEL=nightly

VITE_API_BASE_URL=http://localhost:8000/api
VITE_BACKEND_URL=http://localhost:3000
VITE_SOLANA_RPC_URL=https://api.devnet.solana.com

VITE_PRIMARY_POOL_HOST=localhost
VITE_PRIMARY_STRATUM_PORT=3333
VITE_PRIMARY_RPC_HOST=localhost
VITE_PRIMARY_MONERO_RPC_PORT=18089
VITE_ENABLE_BACKUP_POOL=false
