# Code signing certificates and secrets (NEVER COMMIT)
certs/
*.pfx
*.p12
*.cer
*.crt
*.pem
.env.local
.env.signing
.env
.sh
*.ps1
# The installer scripts are shipped inside the bundle and referenced by the NSIS
# hooks, so they have to be tracked even though other local scripts are not.
!src-tauri/resources/installer/*.ps1
!src-tauri/resources/sensor-broker/*.ps1
# Tracked release script (un-ignore the one entry point we ship)
!scripts/release-win.ps1
*.yml
*.yaml
!.github/workflows/*.yml
!.github/workflows/*.yaml
!bitbucket-pipelines.yml
*.sql
.env.*
!.env.example
!.env.*.example

