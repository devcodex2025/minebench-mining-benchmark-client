# MineBench Client environment template.
# Copy to `.env` and fill in real values. `.env` is git-ignored — NEVER commit it.
# Vite only exposes variables prefixed with VITE_ to the client bundle; these
# values are public by design.

# Backend / API endpoints
VITE_API_BASE_URL=
VITE_BACKEND_URL=

# Public BMT token mint address (public, not a secret)
VITE_BMT_TOKEN_MINT=

# Primary Monero pool connection (public infrastructure)
VITE_PRIMARY_POOL_HOST=
VITE_PRIMARY_STRATUM_PORT=
VITE_PRIMARY_RPC_HOST=
VITE_PRIMARY_MONERO_RPC_PORT=
VITE_ENABLE_BACKUP_POOL=

# Remote public config (public URL + allowlist, non-secret)
PUBLIC_CONFIG_URL=
POOL_CONFIG_ALLOWLIST=
