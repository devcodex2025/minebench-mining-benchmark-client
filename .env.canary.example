# Canary channel: release candidates ship to production infrastructure, so these
# endpoints are production. scripts/check-channel-config.mjs fails the build if
# any of them points at a test or local host.
#
# Copy to `.env.canary` (git-ignored) or let CI inject the same variables.
VITE_APP_CHANNEL=canary

VITE_API_BASE_URL=https://backend.minebench.cloud/api
VITE_BACKEND_URL=https://backend.minebench.cloud
VITE_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

VITE_PRIMARY_POOL_HOST=xmr.minebench.cloud
VITE_PRIMARY_STRATUM_PORT=3333
VITE_PRIMARY_RPC_HOST=xmr.minebench.cloud
VITE_PRIMARY_MONERO_RPC_PORT=18089
VITE_ENABLE_BACKUP_POOL=false
